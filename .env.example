# Copy to .env for local/Render. Do NOT commit real values.
# Shared secret for GET /probe-log?key=…
PROBE_LOG_KEY=phase0-change-me

# Layer D beacon (Phase 0). Probe.js POSTs same-origin /api/beacon;
# Render forwards server-to-server with x-beacon-secret (never in page source).
# BEACON_SITE_KEY=          # issued merchantId / site_key
# BEACON_UPSTREAM=          # https://<scanner-host>/api/public/beacon
# BEACON_INGEST_SECRET=     # shared write credential (Render env only)
# Legacy alias still accepted for upstream URL only:
# BEACON_ENDPOINT=          # same as BEACON_UPSTREAM if set

# Optional. Render sets PORT automatically.
# PORT=3000
