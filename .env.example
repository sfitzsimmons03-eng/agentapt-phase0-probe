# Copy to .env for local/Render. Do NOT commit real values.
# Shared secret for GET /probe-log?key=…
PROBE_LOG_KEY=phase0-change-me

# Layer D beacon (optional). When both are set, checkout pages inject
# window.__AGENTAPT_BEACON__ and probe.js POSTs fill-session events.
# site key = issued merchantId (not domain). Endpoint = Worker /v1/beacon URL.
# BEACON_SITE_KEY=
# BEACON_ENDPOINT=https://agentapt-beacon.<account>.workers.dev/v1/beacon

# Optional. Render sets PORT automatically.
# PORT=3000
